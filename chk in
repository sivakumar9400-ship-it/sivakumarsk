import java.util.Scanner;
class Parent {
    void print() {
        System.out.println("Parent");
    }
}

class Child extends Parent {
    
    void print() {
        System.out.println("Child");
    }
}

public class Main {
    public static void main(String[] args) {
        Parent p = new Parent();
        p.print();

        Child c = new Child();
        c.print();
    }
}
